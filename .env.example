# Database Configuration (Aiven / Local MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecommerce_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Server Port (Render assigns PORT automatically in production)
PORT=8080

# JWT Security Secret (Use a strong Base64 256-bit string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Origins (Comma-separated origins, e.g. Vercel deployment URL https://your-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Optional Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder
